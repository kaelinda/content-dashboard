{
  "name": "content-dashboard",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts && npm run test:agents && npm run test:operations",
    "test:e2e": "node scripts/test-browser.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "restore": "tsx scripts/restore.ts",
    "check": "npm run typecheck && npm test && npm run test:config && npm run test:integration && npm run build",
    "test:agents": "tsx --test tests/agent.test.ts && node --test tests/agent-client.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "docker:up": "node scripts/compose.mjs",
    "test:config": "node --test tests/config.test.mjs",
    "test:operations": "tsx --test tests/operations.test.ts",
    "storage:reconcile": "tsx scripts/reconcile.ts",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@electric-sql/pglite": "^0.3.14",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@aws-sdk/client-s3": "^3.1154.0",
    "pg": "^8.16.3",
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.1"
  }
}
