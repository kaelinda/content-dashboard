# Content Hub: private server configuration (template only, never paste real secrets here).
# FIRST INSTALL: npm run setup (native) / npm run setup -- --docker (new Compose DB).
# MAINTAIN: edit .env.local in the project root; then npm run doctor and restart.
# Existing .env files and credentials are never overwritten by setup.

# 1. Browser/Agent external root address, NOT the listen address. Remote requires HTTPS.
APP_URL=http://localhost:3000
# scrypt hash generated by setup, NOT a plaintext login password.
OWNER_PASSWORD_HASH=
# Native listen address/port. For Compose, PORT maps a loopback host port to container 3000.
HUB_HOST=127.0.0.1
PORT=3000

# 2. Database: empty = on-disk single-process PGlite. Never open the same directory twice.
# External PostgreSQL: postgres://user:percent-encoded-password@host:5432/database
DATABASE_URL=
DATA_DIR=.data
# Compose only; setup --docker creates 48 random hex chars. Do not rotate an existing DB by editing this.
POSTGRES_PASSWORD=

# 3. Private blobs: local | s3. Changing storage is NOT data migration.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# Fill both keys, or leave both empty to use the AWS SDK runtime credential chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional temporary credential token when explicit S3 keys are used.
S3_SESSION_TOKEN=

# 4. Optional registered OAuth clients; [] means not configured. No public registration/auto-consent.
# Use exact client redirect URIs. Write access additionally requires an existing scoped agent_id.
# OAUTH_CLIENTS_JSON='[{"id":"writer","name":"Writer","redirect_uris":["https://client.example/callback"],"agent_id":"actual-agent-id"}]'
OAUTH_CLIENTS_JSON=[]

# Keep secrets server-only: NEVER use NEXT_PUBLIC_ for passwords, keys or connection strings.
# Next.js expands $VARIABLE even inside quotes. For a literal $, use \$ in .env.local.
# Prefer npm run docker:up to pass the same parsed configuration to Compose.
# Agent executor HUB_URL/HUB_TOKEN/HUB_PROJECT_ID belong in that executor, not the Hub server's file.
