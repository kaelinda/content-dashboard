# Run npm run setup to generate a strong owner password and this file locally.
APP_URL=http://localhost:3000
OWNER_PASSWORD_HASH=
# Empty = single-process, on-disk PGlite. Never run two servers against the same directory.
DATABASE_URL=
DATA_DIR=.data
# local | s3. Local blobs are private and served through authenticated routes.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Pre-register OAuth clients; no automatic public registration or consent.
# Obtain the exact redirect URI from the client; do not use wildcard URLs.
OAUTH_CLIENTS_JSON=[]
